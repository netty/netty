    </profile>
    <profile>
      <id>oss-fuzz</id>
      <properties>
        <jni.compiler.args.cflags>CFLAGS=${env.CFLAGS} -I${unix.common.include.unpacked.dir}</jni.compiler.args.cflags>
      </properties>
    </profile>
    <!-- Builds the native library for all the linux targets we release it for, in one build, with the cross compile
         toolchain of docker/Dockerfile.cross_compile (see docker/README.md):

           ./mvnw -Pcross-compile-all clean package

         Declared last, so it can replace the executions of the profile of the host. -->
    <profile>
      <id>cross-compile-all</id>
      <properties>
        <crossCompileScripts>${project.basedir}/../docker/cross-compile</crossCompileScripts>
        <crossDir>${project.build.directory}/cross</crossDir>
        <crossLibPlaceholder>netty_native_lib_placeholder</crossLibPlaceholder>
      </properties>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack</id>
                <phase>none</phase>
              </execution>
              <!-- The unix-common static library and include files, for every target -->
              <execution>
                <id>unpack-cross</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>${project.groupId}</groupId>
                      <artifactId>netty-transport-native-unix-common</artifactId>
                      <version>${project.version}</version>
                      <classifier>linux-x86_64</classifier>
                      <outputDirectory>${crossDir}/linux-x86_64/unix-common</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>${project.groupId}</groupId>
                      <artifactId>netty-transport-native-unix-common</artifactId>
                      <version>${project.version}</version>
                      <classifier>linux-aarch_64</classifier>
                      <outputDirectory>${crossDir}/linux-aarch_64/unix-common</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>${project.groupId}</groupId>
                      <artifactId>netty-transport-native-unix-common</artifactId>
                      <version>${project.version}</version>
                      <classifier>linux-riscv64</classifier>
                      <outputDirectory>${crossDir}/linux-riscv64/unix-common</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                  <includes>META-INF/native/**</includes>
                  <overWriteSnapshots>true</overWriteSnapshots>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.fusesource.hawtjni</groupId>
            <artifactId>hawtjni-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>build-native-lib</id>
                <phase>none</phase>
              </execution>
              <!-- Only the native package, with a placeholder for the name of the library, see build-native-libs-cross -->
              <execution>
                <id>generate-native-package-cross</id>
                <configuration>
                  <name>${crossLibPlaceholder}</name>
                  <nativeSourceDirectory>${nativeSourceDirectory}</nativeSourceDirectory>
                </configuration>
                <goals>
                  <goal>generate</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.felix</groupId>
            <artifactId>maven-bundle-plugin</artifactId>
            <executions>
              <execution>
                <id>native-manifest</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>native-jar</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>build-native-libs-cross</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <macrodef name="build-native-lib">
                      <attribute name="target" />
                      <attribute name="triple" />
                      <attribute name="arch" />
                      <sequential>
                        <ant antfile="${crossCompileScripts}/cross-compile-all.xml" target="prepare-native-package">
                          <property name="cross.dir" value="${crossDir}" />
                          <property name="cross.target" value="@{target}" />
                          <property name="package.dir" value="${project.build.directory}/generated-sources/hawtjni/native-package" />
                          <property name="lib.placeholder" value="${crossLibPlaceholder}" />
                          <property name="lib.name" value="netty_transport_native_epoll_@{arch}" />
                        </ant>
                        <exec executable="${crossCompileScripts}/env.sh" dir="${crossDir}/@{target}/native-build" failonerror="true">
                          <arg value="@{target}" />
                          <arg value="./configure" />
                          <arg value="--prefix=${crossDir}/@{target}/native-build/target" />
                          <arg value="--libdir=${crossDir}/@{target}/native-build/target/lib" />
                          <arg value="--host=@{triple}" />
                          <arg value="CC=@{triple}-gcc" />
                          <arg value="LDFLAGS=${nativeLdflags} -L${crossDir}/@{target}/unix-common/META-INF/native/lib" />
                          <arg value="LIBS=${nativeLibs}" />
                          <arg value="CFLAGS=${nativeCflags} -I${crossDir}/@{target}/unix-common/META-INF/native/include" />
                        </exec>
                        <exec executable="${crossCompileScripts}/env.sh" dir="${crossDir}/@{target}/native-build" failonerror="true">
                          <arg value="@{target}" />
                          <arg value="make" />
                          <arg value="install" />
                        </exec>
                        <ant antfile="${crossCompileScripts}/cross-compile-all.xml" target="check-glibc-versions">
                          <property name="cross.target" value="@{target}" />
                          <property name="lib.file" value="${crossDir}/@{target}/native-build/target/lib/libnetty_transport_native_epoll_@{arch}.so" />
                        </ant>
                      </sequential>
                    </macrodef>
                    <build-native-lib target="linux-x86_64" triple="x86_64-linux-gnu" arch="x86_64" />
                    <build-native-lib target="linux-aarch_64" triple="aarch64-linux-gnu" arch="aarch_64" />
                    <build-native-lib target="linux-riscv64" triple="riscv64-linux-gnu" arch="riscv64" />
                  </target>
                </configuration>
              </execution>
              <!-- The same as native-manifest and native-jar, for every target -->
              <execution>
                <id>native-jars-cross</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <macrodef name="native-jar">
                      <attribute name="target" />
                      <attribute name="arch" />
                      <attribute name="processor" />
                      <sequential>
                        <ant antfile="${crossCompileScripts}/cross-compile-all.xml" target="native-jar">
                          <property name="cross.dir" value="${crossDir}" />
                          <property name="cross.target" value="@{target}" />
                          <property name="base.dir" value="${project.build.outputDirectory}" />
                          <property name="default.jar" value="${project.build.directory}/${project.build.finalName}.jar" />
                          <property name="lib.file" value="${crossDir}/@{target}/native-build/target/lib/libnetty_transport_native_epoll_@{arch}.so" />
                          <property name="module.name" value="${fallbackModuleName}.linux.@{arch}" />
                          <property name="manifest.template" value="${project.build.outputDirectory}/META-INF/MANIFEST.MF" />
                          <property name="bundle.native.code" value="META-INF/native/libnetty_transport_native_epoll_@{arch}.so; osname=Linux; processor=@{processor},*" />
                          <property name="fragment.host" value="io.netty.transport-classes-epoll" />
                          <property name="dest.jar" value="${project.build.directory}/${project.build.finalName}-@{target}.jar" />
                        </ant>
                        <attachartifact file="${project.build.directory}/${project.build.finalName}-@{target}.jar" classifier="@{target}" type="jar" />
                      </sequential>
                    </macrodef>
                    <native-jar target="linux-x86_64" arch="x86_64" processor="x86_64" />
                    <native-jar target="linux-aarch_64" arch="aarch_64" processor="aarch64" />
                    <native-jar target="linux-riscv64" arch="riscv64" processor="riscv64" />
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-buffer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-classes-epoll</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-testsuite</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common-tests</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>${tcnative.artifactId}</artifactId>
      <classifier>${tcnative.classifier}</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.artsok</groupId>
      <artifactId>rerunner-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- For SelfSignedCertificate usage on JDK20+ -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>


  <build>
    <plugins>
      <!-- Also include c files in source jar -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${nativeSourceDirectory}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <!-- Copy files for the fallback JAR that does not contain the native library
               and a different module declaration -->
          <execution>
            <id>copy-to-native-output</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <taskdef resource="net/sf/antcontrib/antcontrib.properties" />

                <copy todir="${fallbackOutputDirectory}" includeEmptyDirs="false">
                  <zipfileset dir="${project.build.outputDirectory}" excludes="META-INF/versions/**,META-INF/native/**" />
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.dmlloyd.module-info</groupId>
        <artifactId>module-info</artifactId>
        <executions>
          <execution>
            <id>module-info</id>
          </execution>
          <execution>
            <id>fallback-module-info</id>
            <phase>process-classes</phase>
            <configuration>
              <moduleName>${fallbackModuleName}</moduleName>
              <outputDirectory>${fallbackOutputDirectory}/META-INF/versions/11/</outputDirectory>
            </configuration>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <!-- We must generate a -javadoc JAR file to publish on Maven Central -->
          <execution>
            <id>empty-javadoc-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>javadoc</classifier>
              <classesDirectory>${basedir}/javadoc</classesDirectory>
            </configuration>
          </execution>
          <!-- Generate the fallback JAR that does not contain the native library. -->
          <execution>
            <id>default-jar</id>
            <configuration>
              <classesDirectory>${fallbackOutputDirectory}</classesDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

