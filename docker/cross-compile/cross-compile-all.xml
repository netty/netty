<!--
  Steps shared by the cross-compile-all profiles of the native modules, which build the native libraries for all
  target platforms in one maven build (in docker/Dockerfile.cross_compile, see docker/README.md). Called with <ant>
  from the maven-antrun-plugin, with the properties described for each target. The work for a target happens in
  ${cross.dir}/${cross.target}, so the targets don't share anything.
-->
<project name="cross-compile-all" default="native-jar">

  <!--
    Prepares a copy of the native package generated by hawtjni (generate goal) for one target:
    copies ${package.dir} to ${cross.dir}/${cross.target}/native-build, replaces the placeholder library name the
    package was generated with (${lib.placeholder}) with ${lib.name}, and regenerates the autotools files.
    Optional: ${custom.m4}, copied to m4/custom.m4 of the package before that.
  -->
  <target name="prepare-native-package">
    <property name="build.dir" value="${cross.dir}/${cross.target}/native-build" />
    <delete dir="${build.dir}" />
    <mkdir dir="${build.dir}" />
    <!-- cp keeps the executable bits (not with -p, which fails on docker volumes mounted from macOS) -->
    <exec executable="cp" failonerror="true">
      <arg value="-R" />
      <arg value="${package.dir}/." />
      <arg value="${build.dir}" />
    </exec>
    <delete dir="${build.dir}/autom4te.cache" />
    <delete file="${build.dir}/configure" />
    <delete file="${build.dir}/Makefile.in" />
    <delete file="${build.dir}/aclocal.m4" />
    <replace dir="${build.dir}" includes="configure.ac,Makefile.am" token="${lib.placeholder}" value="${lib.name}" summary="true" />
    <copy file="${custom.m4}" tofile="${build.dir}/m4/custom.m4" overwrite="true" failonerror="false" />
    <exec executable="/bin/sh" dir="${build.dir}" failonerror="true">
      <arg value="./autogen.sh" />
    </exec>
  </target>

  <!--
    Fails if the Linux native library ${lib.file} requires a newer glibc than we support, like the
    check-native-glibc-versions profile of the parent pom does for builds of one target (see there).
    Only when NETTY_CHECK_NATIVE_GLIBC_VERSIONS is true and ${skipNativeGlibcVersionsCheck} is not.
  -->
  <target name="check-glibc-versions">
    <property environment="env" />
    <condition property="check.glibc">
      <and>
        <equals arg1="${env.NETTY_CHECK_NATIVE_GLIBC_VERSIONS}" arg2="true" />
        <not>
          <equals arg1="${skipNativeGlibcVersionsCheck}" arg2="true" />
        </not>
        <matches string="${cross.target}" pattern="^linux-" />
      </and>
    </condition>
    <antcall target="-check-glibc-versions" />
  </target>

  <target name="-check-glibc-versions" if="check.glibc">
    <!-- Relative to this file, as the properties of the maven project are not all available in here -->
    <dirname property="cross.compile.scripts.dir" file="${ant.file.cross-compile-all}" />
    <exec executable="bash" failonerror="true">
      <arg value="${cross.compile.scripts.dir}/../../.github/scripts/check_native_glibc_versions.sh" />
      <arg value="${lib.file}" />
    </exec>
  </target>

  <!--
    Builds the jar with the native library for one target, like the native-jar executions of the modules do for
    builds of one target:
      ${base.dir}            the output directory of the module, without META-INF/native, the module-info and the
                             manifest
      ${default.jar}         the jar without classifier, for META-INF/maven
      ${lib.file}            the native library, put in META-INF/native/${lib.file.name} (defaults to its name)
      ${module.name}         the name of the module-info put in META-INF/versions/11 (compiled with javac)
      ${manifest.template}   the manifest of the module, of which Bundle-NativeCode (${bundle.native.code}) and
                             Fragment-Host (${fragment.host}) are replaced, and the target is appended to
                             Bundle-SymbolicName
      ${dest.jar}            the jar to create
  -->
  <target name="native-jar">
    <property name="work.dir" value="${cross.dir}/${cross.target}/jar" />
    <basename property="lib.file.name" file="${lib.file}" />
    <delete dir="${work.dir}" />
    <mkdir dir="${work.dir}/META-INF/native" />
    <copy todir="${work.dir}" includeEmptyDirs="false">
      <fileset dir="${base.dir}" excludes="META-INF/native/**,META-INF/versions/11/module-info.class,META-INF/MANIFEST.MF" />
    </copy>
    <copy todir="${work.dir}" includeEmptyDirs="false">
      <zipfileset src="${default.jar}" includes="META-INF/maven/**" />
    </copy>
    <copy file="${lib.file}" tofile="${work.dir}/META-INF/native/${lib.file.name}" />

    <!-- The same module-info the module-info plugin generates: just the name and version of the module -->
    <property name="module.src.dir" value="${cross.dir}/${cross.target}/module-info" />
    <delete dir="${module.src.dir}" />
    <mkdir dir="${module.src.dir}" />
    <echo file="${module.src.dir}/module-info.java">module ${module.name} {${line.separator}}${line.separator}</echo>
    <mkdir dir="${work.dir}/META-INF/versions/11" />
    <exec executable="${java.home}/bin/javac" failonerror="true">
      <arg value="--release" />
      <arg value="11" />
      <arg value="--module-version" />
      <arg value="${project.version}" />
      <arg value="-d" />
      <arg value="${work.dir}/META-INF/versions/11" />
      <arg value="${module.src.dir}/module-info.java" />
    </exec>

    <!-- Like the native-manifest executions: the symbolic name of the module, plus the classifier -->
    <taskdef resource="net/sf/antcontrib/antcontrib.properties" />
    <loadfile property="manifest.template.content" srcFile="${manifest.template}" />
    <propertyregex property="symbolic.name.base" input="${manifest.template.content}" regexp="(?m)^Bundle-SymbolicName: *([^;\s]+)" select="\1" />
    <fail unless="symbolic.name.base" message="No Bundle-SymbolicName in ${manifest.template}" />
    <property name="bundle.symbolic.name" value="${symbolic.name.base}.${cross.target}" />

    <property name="manifest.file" value="${cross.dir}/${cross.target}/MANIFEST.MF" />
    <copy file="${manifest.template}" tofile="${manifest.file}" overwrite="true" />
    <manifest file="${manifest.file}" mode="update">
      <attribute name="Bundle-NativeCode" value="${bundle.native.code}" />
      <attribute name="Bundle-SymbolicName" value="${bundle.symbolic.name}" />
      <attribute name="Fragment-Host" value="${fragment.host}" />
      <attribute name="Multi-Release" value="true" />
    </manifest>

    <delete file="${dest.jar}" />
    <jar destfile="${dest.jar}" manifest="${manifest.file}" basedir="${work.dir}" index="true" />
  </target>
</project>
