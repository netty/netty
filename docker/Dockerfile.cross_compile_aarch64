FROM --platform=linux/amd64 centos:7.9.2009

ARG gcc_version=10.3-2021.07
# Arm only publishes an MD5 for this release, so this SHA-256 was computed from the download (MD5 cross-checked).
ARG gcc_sha256=1e33d53dea59c8de823bbdfe0798280bdcd138636c7060da9d77a97ded095a84
ENV GCC_VERSION=$gcc_version
ENV GCC_SHA256=$gcc_sha256
ENV SOURCE_DIR=/root/source
ENV CMAKE_VERSION_BASE=3.26
ENV CMAKE_VERSION=$CMAKE_VERSION_BASE.4
ENV SOURCE_DIR=/root/source
ENV WORKSPACE_DIR=/root/workspace
ENV PROJECT_DIR=/root/workspace/project


# Update to use the vault
RUN sed -i -e 's/^mirrorlist/#mirrorlist/g' -e 's/^#baseurl=http:\/\/mirror.centos.org\/centos\/$releasever\//baseurl=https:\/\/linuxsoft.cern.ch\/centos-vault\/\/7.9.2009\//g' /etc/yum.repos.d/CentOS-Base.repo

RUN yum -y install epel-release

# Install requirements. patchelf is what drops the DT_NEEDED on ld-linux-<arch>.so from the
# linked native libraries, which is what makes them loadable under musl; see
# codec-native-quic/pom.xml.
RUN yum install -y \
 apr-devel \
 autoconf \
 automake \
 bzip2 \
 git \
 glibc-devel \
 golang \
 gnupg \
 libaio-devel \
 libtool \
 lksctp-tools \
 redhat-lsb-core \
 ninja-build \
 make \
 openssl-devel \
 patchelf \
 perl \
 tar \
 unzip \
 wget \
 zip

# Install Java
RUN yum install -y java-11-openjdk-devel
ENV JAVA_HOME="/usr/lib/jvm/java-11-openjdk/"

RUN mkdir $SOURCE_DIR
WORKDIR $SOURCE_DIR

# Refresh the CA bundle so wget can verify the TLS chain of the download hosts.
RUN yum update -y ca-certificates

# Install aarch64 gcc 10.2 toolchain
RUN wget -q https://developer.arm.com/-/media/Files/downloads/gnu-a/$GCC_VERSION/binrel/gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu.tar.xz && \
  echo "$GCC_SHA256  gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu.tar.xz" | sha256sum -c - && \
  tar xf gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu.tar.xz && rm -f gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu.tar.xz && mv gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu /opt/
ENV PATH="/opt/gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu/bin:${PATH}"

# Install CMake
RUN wget -q https://github.com/Kitware/CMake/releases/download/v$CMAKE_VERSION/cmake-$CMAKE_VERSION-linux-x86_64.tar.gz && tar zxf cmake-$CMAKE_VERSION-linux-x86_64.tar.gz && mv cmake-$CMAKE_VERSION-linux-x86_64 /opt/ && echo 'PATH=/opt/cmake-$CMAKE_VERSION-linux-x86_64/bin:$PATH' >> ~/.bashrc

# Add pre-build clang so we can compile quiche.
RUN wget -q https://github.com/netty/netty/releases/download/netty-clang-bin/centos-7-clang-18.1.8-bin.tar.xz && tar xf centos-7-clang-18.1.8-bin.tar.xz && rm -f centos-7-clang-18.1.8-bin.tar.xz && mv clang-18.1.8 /opt/ && echo 'PATH=/opt/cclang-18.1.8/bin:$PATH' >> ~/.bashrc && echo 'export LIBCLANG_PATH=/opt/clang-18.1.8/lib' >>  ~/.bashrc && echo 'export BINDGEN_EXTRA_CLANG_ARGS="-I /opt/clang-18.1.8/lib/clang/18/include/ --sysroot=/opt/gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu/aarch64-none-linux-gnu/libc"' >>  ~/.bashrc

ARG rustup_version=1.29.1
ARG rustup_sha256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ENV RUSTUP_VERSION=$rustup_version
ENV RUSTUP_SHA256=$rustup_sha256

# install rust and setup PATH and install correct toolchain
RUN curl -fsSL -o /tmp/rustup-init https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/x86_64-unknown-linux-gnu/rustup-init && \
    echo "$RUSTUP_SHA256  /tmp/rustup-init" | sha256sum -c - && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y && \
    rm -f /tmp/rustup-init
ENV PATH="$HOME/.cargo/bin:${PATH}"
RUN /root/.cargo/bin/rustup target add aarch64-unknown-linux-gnu

# Setup the correct linker
RUN echo '[target.aarch64-unknown-linux-gnu]' >> /root/.cargo/config
RUN echo 'linker = "aarch64-none-linux-gnu-gcc"' >> /root/.cargo/config

# Downloading and installing SDKMAN!
ARG sdkman_install_sha256=76129982e764737a5dcbab50efcf854c9688b42e7e50a8a6c7e3fa6d52782aa5
ENV SDKMAN_INSTALL_SHA256=$sdkman_install_sha256
# The installer script is not versioned by SDKMAN!, so the pinned SHA-256 needs to be updated when it changes.
RUN curl -fsSL -o /tmp/sdkman-install.sh "https://beta.sdkman.io?ci=true" && \
    echo "$SDKMAN_INSTALL_SHA256  /tmp/sdkman-install.sh" | sha256sum -c - && \
    bash /tmp/sdkman-install.sh && \
    rm -f /tmp/sdkman-install.sh

# Installing Java and Maven, removing some unnecessary SDKMAN files
RUN bash -c "source $HOME/.sdkman/bin/sdkman-init.sh && \
    rm -rf $HOME/.sdkman/archives/* && \
    rm -rf $HOME/.sdkman/tmp/*"

# Cleanup
RUN rm -rf $SOURCE_DIR
RUN yum clean all && \
    rm -rf /var/cache/yum
