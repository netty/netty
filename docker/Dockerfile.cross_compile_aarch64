FROM --platform=linux/amd64 centos:7.6.1810

ARG gcc_version=10.3-2021.07
# Arm only publishes an MD5 for this release, so this SHA-256 was computed from the download (MD5 cross-checked).
ARG gcc_sha256=1e33d53dea59c8de823bbdfe0798280bdcd138636c7060da9d77a97ded095a84
ENV GCC_VERSION $gcc_version
ENV GCC_SHA256 $gcc_sha256
ENV SOURCE_DIR /root/source

# Update to use the vault
RUN sed -i -e 's/^mirrorlist/#mirrorlist/g' -e 's/^#baseurl=http:\/\/mirror.centos.org\/centos\/$releasever\//baseurl=https:\/\/linuxsoft.cern.ch\/centos-vault\/\/7.6.1810\//g' /etc/yum.repos.d/CentOS-Base.repo

# Install requirements
RUN yum install -y wget tar git make redhat-lsb-core autoconf automake libtool glibc-devel libaio-devel openssl-devel apr-devel lksctp-tools unzip zip

# Install Java
RUN yum install -y java-1.8.0-openjdk-devel

RUN mkdir $SOURCE_DIR
WORKDIR $SOURCE_DIR

# Install aarch64 gcc 10.2 toolchain
# The CA bundle of this old image can't verify developer.arm.com anymore, integrity is ensured by the SHA-256 check.
RUN wget --no-check-certificate https://developer.arm.com/-/media/Files/downloads/gnu-a/$GCC_VERSION/binrel/gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu.tar.xz && \
   echo "$GCC_SHA256  gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu.tar.xz" | sha256sum -c - && \
   tar xf gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu.tar.xz && mv gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu /opt/
ENV PATH="/opt/gcc-arm-$GCC_VERSION-x86_64-aarch64-none-linux-gnu/bin:${PATH}"

ENV JAVA_HOME="/usr/lib/jvm/java-1.8.0-openjdk/"

# Cleanup
RUN rm -rf $SOURCE_DIR
RUN yum clean all && \
    rm -rf /var/cache/yum